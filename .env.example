# Google Gemini API Key
GOOGLE_API_KEY= api key // Go to google studio to get one 

# Flask Configuration
FLASK_SECRET_KEY=  flask secret key// local based 
FLASK_DEBUG=true
PORT=5001( change the port number if its unavailable)

# Model Configuration
MODEL_NAME=gemini-2.5-flash ( best for the text generation) // you can also groq model for faster generation 
TEMPERATURE=0.7
MAX_TOKENS=3000
GEMINI_TIMEOUT=30
GEMINI_MAX_RETRIES=3
